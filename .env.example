# Database (Railway Postgres)
DATABASE_URL=postgresql://user:password@host:port/database

# Clerk Authentication
# NEXT_PUBLIC_ is inlined into the client at build time. The old
# VITE_CLERK_PUBLISHABLE_KEY name still works as a fallback.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
# Dev only: skip Clerk entirely (ignored outside `next dev`)
# NEXT_PUBLIC_DEV_NO_AUTH=true

# Canonical site URL (metadata, sitemap). Defaults to https://specklab.io
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Storage - Railway Buckets (production)
# These are auto-injected when you link a Railway Bucket to your service
# BUCKET_ENDPOINT=https://storage.railway.app
# BUCKET_ACCESS_KEY_ID=xxx
# BUCKET_SECRET_ACCESS_KEY=xxx
# BUCKET_NAME=videos-abc123
# BUCKET_REGION=us-west-2

# Storage - MinIO (local development)
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=videos

# Application
NODE_ENV=development
LOG_LEVEL=debug
PORT=3000
